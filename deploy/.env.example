# AI Agent Orchestrator — Production Environment

NODE_ENV=production
PORT=3000

# Your domain or public IP (required for Telegram webhooks)
# Example: https://yourdomain.com or http://123.456.789.0
PUBLIC_URL=

# MySQL database connection
# Format: mysql://user:password@host:port/database
DATABASE_URL=mysql://orchestrator:your_db_password@localhost:3306/agentstack

# JWT secret for auth tokens (generate with: openssl rand -base64 48)
JWT_SECRET=change_me_to_a_random_64_character_string_minimum

# Encryption key for API keys (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=change_me_to_a_random_32_character_string

# Fallback app secret (can be same as ENCRYPTION_KEY)
APP_SECRET=change_me_to_a_random_32_character_string
